<%= content_for :page_title, t(".accounts") %>
<%= content_for :page_actions do %>
  <%= render "accounts/sync_controls", family: Current.family %>
  <%= render DS::Link.new(
    text: t(".new_account"),
    href: new_account_path(return_to: accounts_path),
    variant: "primary",
    icon: "plus",
    frame: :modal
  ) %>
<% end %>

<% if @manual_accounts.empty? %>
  <%= render "empty" %>
<% else %>
  <div class="space-y-2">
    <div id="manual-accounts">
      <%= render "accounts/index/manual_accounts", accounts: @manual_accounts %>
    </div>
  </div>
<% end %>
